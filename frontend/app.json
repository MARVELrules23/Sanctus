{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find Catholic churches near you",
        "NSPhotoLibraryUsageDescription": "Attach photos to your profile and Saints entries",
        "NSCalendarsUsageDescription": "Save parish events to your calendar",
        "NSCalendarsFullAccessUsageDescription": "Save parish events to your calendar",
        "NSRemindersUsageDescription": "Add prayer reminders to your reminders"
      },
      "bundleIdentifier": "app.emergent.faithfulfitness329c749ee"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_MEDIA_IMAGES",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "package": "app.emergent.faithfulfitness38b5cf76e"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#1A2233"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Save parish events to your calendar"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportEmail": "philipwils13@gmail.com",
      "supportUrl": "/api/legal/support",
      "privacyPolicyUrl": "/api/legal/privacy"
    }
  }
}
